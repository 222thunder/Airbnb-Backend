<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Airbnb Home</title>
    <link href="/output.css" rel="stylesheet" />
  </head>

  <body
    class="flex min-h-screen flex-col bg-linear-to-br from-rose-50 via-white to-rose-100 font-sans"
  >
    <%- include('../partials/nav') %>

    <!-- Main Content -->
    <main class="flex flex-1 flex-col">
      <!-- Hero Section -->
      <section
        class="flex flex-col items-center text-center py-16 px-6 max-w-3xl mx-auto w-full"
      >
        <h1
          class="text-5xl font-extrabold tracking-tight text-gray-900 md:text-6xl"
        >
          Host Home List <span class="text-[#FF5A5F]">Homes</span>
        </h1>
      </section>

      <!-- Listings Section -->
      <section class="py-12 max-w-7xl mx-auto w-full px-6 flex-1">
        <h2
          class="text-3xl font-extrabold text-gray-900 text-left mb-8 tracking-tight border-b border-gray-100 pb-4 md:text-4xl"
        >
          Registered homes
        </h2>

        <% if (registeredHomes.length === 0) { %>
        <!-- Empty State -->
        <div
          class="mt-8 flex flex-col items-center justify-center rounded-2xl border-2 border-dashed border-rose-250 bg-white/50 p-12 text-center backdrop-blur-xs"
        >
          <div
            class="flex h-16 w-16 items-center justify-center rounded-full bg-rose-100 text-rose-500"
          >
            <svg
              class="h-8 w-8"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"
              />
            </svg>
          </div>
          <h3 class="mt-4 text-xl font-bold text-gray-900">
            No registered homes yet
          </h3>
          <p class="mt-2 max-w-sm text-sm text-gray-500">
            Be the first to list your place and start hosting guests from around
            the globe.
          </p>
          <a
            href="/host/add-home"
            class="mt-6 rounded-full bg-[#FF5A5F] px-6 py-2.5 text-sm font-semibold text-white shadow-md transition hover:bg-[#e54e52] active:scale-95"
          >
            List your home
          </a>
        </div>
        <% } else { %>
        <!-- Grid of Registered Homes -->
        <div
          class="grid grid-cols-1 gap-8 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 max-w-xs mx-auto sm:max-w-none"
        >
          <% registeredHomes.forEach((home, index) => { %>
          <!-- Card -->
          <div
            class="group flex flex-col overflow-hidden rounded-2xl bg-white shadow-xs border border-gray-150 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-md"
          >
            <!-- Image Placeholder Area -->
            <div
              class="relative aspect-square w-full overflow-hidden bg-linear-to-br from-rose-100 to-rose-200 flex items-center justify-center text-rose-500"
            >
              <img
                src="/<%= home.photo %>"
                alt="<%= home.houseName %>"
                class="h-full w-full object-cover"
              />
            </div>

            <!-- Card Body -->
            <div class="flex flex-1 flex-col p-4 text-left">
              <div class="flex items-center justify-between">
                <h3 class="font-bold text-gray-900 truncate pr-2 text-base">
                  <%= home.houseName %>
                </h3>
                <div
                  class="flex items-center text-sm font-semibold text-gray-900 shrink-0"
                >
                  <svg
                    class="h-4 w-4 text-amber-500 mr-0.5"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                    />
                  </svg>
                  <span><%= home.houseRating %></span>
                </div>
              </div>
              <p class="mt-1 text-sm text-gray-500">Entire home</p>
              <p class="text-xs text-gray-400">Listed by local host</p>

              <div
                class="mt-auto pt-3 flex flex-col gap-2 border-t border-gray-150"
              >
                <div class="flex items-center justify-between">
                  <p class="text-sm font-semibold text-gray-900">
                    <%= home.housePrice %> $
                    <span class="font-normal text-gray-500">/ night</span>
                  </p>
                  <!-- <button
                    type="button"
                    class="rounded-lg bg-emerald-600 px-3 py-1 text-xs font-semibold text-white shadow-xs transition hover:bg-emerald-700 active:scale-95 cursor-pointer"
                  >
                    Add
                  </button> -->
                </div>
                <div class="flex items-center gap-2 pt-2">
                  <a
                    href="/host/edit-home/<%= home._id  %>?editing=true"
                    class="flex-1 flex items-center justify-center gap-1.5 rounded-xl border border-gray-200 bg-gray-50 py-2 text-xs font-bold text-gray-700 shadow-2xs transition-all duration-200 hover:border-gray-300 hover:bg-gray-100 hover:text-gray-900 active:scale-95 cursor-pointer text-center"
                  >
                    <svg
                      class="h-3.5 w-3.5 fill-current text-gray-500"
                      viewBox="0 0 20 20"
                    >
                      <path
                        d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"
                      />
                    </svg>
                    Edit
                  </a>
                  <form
                    action="/host/delete-home/<%=home._id %>"
                    method="POST"
                    class="flex-1"
                  >
                    <button
                      type="submit"
                      class="w-full flex items-center justify-center gap-1.5 rounded-xl border border-rose-200 bg-rose-50/80 py-2 text-xs font-bold text-rose-600 shadow-2xs transition-all duration-200 hover:border-rose-300 hover:bg-rose-100 active:scale-95 cursor-pointer text-center"
                    >
                      <svg
                        class="h-3.5 w-3.5 fill-current text-rose-500"
                        viewBox="0 0 20 20"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z"
                          clip-rule="evenodd"
                        />
                      </svg>
                      Delete
                    </button>
                  </form>
                </div>
              </div>
            </div>
          </div>
          <% }) %>
        </div>
        <% } %>
      </section>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-gray-150 mt-auto py-8">
      <div
        class="max-w-7xl mx-auto px-8 flex flex-col md:flex-row items-center justify-between text-sm text-gray-500 gap-4"
      >
        <div>
          &copy;
          <%= new Date().getFullYear() %>
          Airbnb, Inc.
        </div>
        <div class="flex gap-6">
          <a href="#" class="hover:underline">Privacy</a>
          <a href="#" class="hover:underline">Terms</a>
          <a href="#" class="hover:underline">Sitemap</a>
        </div>
      </div>
    </footer>
  </body>
</html>
