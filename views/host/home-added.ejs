<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home Added</title>
    <link href="/output.css" rel="stylesheet" />
  </head>
  <body
    class="flex min-h-screen flex-col items-center justify-center bg-linear-to-br from-emerald-50 via-white to-emerald-100 px-6 py-16"
  >
    <main
      class="flex flex-col items-center rounded-2xl bg-white p-12 text-center shadow-xl"
    >
      <div
        class="flex h-16 w-16 items-center justify-center rounded-full bg-emerald-100"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-8 w-8 text-emerald-600"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M5 13l4 4L19 7"
          />
        </svg>
      </div>
      <h1 class="mt-6 text-3xl font-bold text-gray-900">
        Home registered successfully
      </h1>
      <p class="mt-2 text-gray-500">Your home has been added to the listing.</p>
      <a
        href="/"
        class="mt-8 rounded-full bg-black px-6 py-3 font-semibold text-white transition hover:bg-gray-800"
        >Go to Home</a
      >
    </main>
  </body>
</html>
