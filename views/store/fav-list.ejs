<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Favorites - Airbnb</title>
    <link href="/output.css" rel="stylesheet" />
  </head>

  <body
    class="flex min-h-screen flex-col bg-linear-to-br from-rose-50 via-white to-rose-100 font-sans"
  >
    <%- include('../partials/nav') %>

    <!-- Main Content -->
    <main class="flex flex-1 flex-col">
      <!-- Hero Section -->
      <section
        class="flex flex-col items-center text-center py-12 px-6 max-w-3xl mx-auto w-full"
      >
        <h1
          class="text-4xl font-extrabold tracking-tight text-gray-900 md:text-5xl"
        >
          Your Saved <span class="text-[#FF5A5F]">Favorites</span>
        </h1>
        <p class="mt-3 text-base md:text-lg text-gray-500 max-w-lg">
          Keep track of the places you love and plan your upcoming getaways.
        </p>
      </section>

      <!-- Favorites Grid Section -->
      <section class="pb-16 max-w-7xl mx-auto w-full px-6 flex-1">
        <div
          class="flex items-center justify-between border-b border-gray-200 pb-4 mb-8"
        >
          <h2 class="text-2xl font-extrabold text-gray-900 tracking-tight">
            Saved Homes
          </h2>
          <span
            class="rounded-full bg-rose-100 px-3 py-1 text-xs font-semibold text-rose-600"
          >
            <%= typeof registeredHomes !== 'undefined' ? registeredHomes.length : 0 %>
            Saved
          </span>
        </div>

        <% if (typeof registeredHomes === 'undefined' || registeredHomes.length === 0) { %>
        <!-- Empty State -->
        <div
          class="mt-8 flex flex-col items-center justify-center rounded-2xl border-2 border-dashed border-rose-200 bg-white/50 p-12 text-center backdrop-blur-xs"
        >
          <div
            class="flex h-16 w-16 items-center justify-center rounded-full bg-rose-100 text-rose-500"
          >
            <svg
              class="h-8 w-8"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"
              />
            </svg>
          </div>
          <h3 class="mt-4 text-xl font-bold text-gray-900">
            No favorite homes yet
          </h3>
          <p class="mt-2 max-w-sm text-sm text-gray-500">
            Explore homes and click the heart icon on any listing to save it to
            your favorites list.
          </p>
          <a
            href="/homes"
            class="mt-6 rounded-full bg-[#FF5A5F] px-6 py-2.5 text-sm font-semibold text-white shadow-md transition hover:bg-[#e54e52] active:scale-95"
          >
            Explore Homes
          </a>
        </div>
        <% } else { %>
        <!-- Grid of Favorite Homes -->
        <div
          class="grid grid-cols-1 gap-8 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 max-w-xs mx-auto sm:max-w-none"
        >
          <% registeredHomes.forEach((home) => { %>
          <div
            class="group relative flex flex-col overflow-hidden rounded-2xl bg-white shadow-sm border border-gray-150 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-md"
          >
            <!-- Image Area -->
            <div
              class="relative aspect-square w-full overflow-hidden bg-rose-100"
            >
              <img
                src="<%= home.photo %>"
                alt="<%= home.houseName %>"
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
              />
              <!-- Filled Heart (Remove from Favorite) Form Button -->
              <form
                action="/favorite/remove"
                method="POST"
                class="absolute top-3 right-3 z-10"
              >
                <input type="hidden" name="homeId" value="<%= home._id  %>" />
                <button
                  type="submit"
                  class="rounded-full bg-white/90 p-2 text-rose-500 shadow-md transition-transform duration-200 hover:scale-110 active:scale-95 cursor-pointer"
                  title="Remove from favorites"
                >
                  <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
                    <path
                      d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                    />
                  </svg>
                </button>
              </form>
            </div>

            <!-- Card Body -->
            <div class="flex flex-1 flex-col p-4 text-left">
              <div class="flex items-center justify-between">
                <h3 class="font-bold text-gray-900 truncate pr-2 text-base">
                  <%= home.houseName %>
                </h3>
                <div
                  class="flex items-center text-sm font-semibold text-gray-900 shrink-0"
                >
                  <svg
                    class="h-4 w-4 text-amber-500 mr-0.5"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                    />
                  </svg>
                  <span><%= home.houseRating %></span>
                </div>
              </div>
              <p class="mt-1 text-xs text-gray-500">
                <%= home.houseLocation %>
              </p>

              <div
                class="mt-auto pt-3 flex items-center justify-between border-t border-gray-150"
              >
                <p class="text-sm font-semibold text-gray-900">
                  <%= home.housePrice %> $
                  <span class="font-normal text-gray-500">/ night</span>
                </p>
                <a
                  href="/homes/<%= home._id  %>"
                  class="rounded-lg bg-[#FF5A5F] px-3.5 py-1.5 text-xs font-semibold text-white shadow-xs transition hover:bg-[#e54e52] active:scale-95"
                >
                  View Details
                </a>
              </div>
            </div>
          </div>
          <% }) %>
        </div>
        <% } %>
      </section>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-gray-150 mt-auto py-8">
      <div
        class="max-w-7xl mx-auto px-8 flex flex-col md:flex-row items-center justify-between text-sm text-gray-500 gap-4"
      >
        <div>
          &copy;
          <%= new Date().getFullYear() %>
          Airbnb, Inc.
        </div>
        <div class="flex gap-6">
          <a href="#" class="hover:underline">Privacy</a>
          <a href="#" class="hover:underline">Terms</a>
          <a href="#" class="hover:underline">Sitemap</a>
        </div>
      </div>
    </footer>
  </body>
</html>
