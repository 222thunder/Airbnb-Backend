<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Page not found</title>
    <link href="/output.css" rel="stylesheet" />
  </head>
  <body
    class="flex min-h-screen flex-col items-center justify-center bg-black px-6 text-center"
  >
    <header class="flex flex-col items-center">
      <h1 class="text-7xl font-extrabold text-[#FF5A5F]">404</h1>
      <h2 class="mt-2 text-2xl font-semibold tracking-wide text-white">
        PAGE NOT FOUND
      </h2>
      <p class="mt-3 max-w-md text-blue-400">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <a
        href="/"
        class="mt-8 rounded-full bg-white px-6 py-3 font-semibold text-black transition hover:bg-gray-200"
        >Go to Home</a
      >
    </header>
  </body>
</html>
