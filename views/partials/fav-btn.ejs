<% if (typeof isLoggedIn !== 'undefined' && isLoggedIn && typeof userType !== 'undefined' && userType === 'guest') { %>
<% const isFav = typeof favoriteIds !== 'undefined' &&
Array.isArray(favoriteIds) &&
favoriteIds.some((fav) => String(fav._id || fav) === String(home._id)); %>

<form
  action="<%= isFav ? '/favorite/remove' : '/favorite/add' %>"
  method="POST"
  onclick="event.stopPropagation()"
  class="absolute top-3 right-3 z-10"
>
  <input type="hidden" name="homeId" value="<%= String(home._id) %>" />
  <button
    type="submit"
    class="rounded-full p-2 shadow-md transition-all duration-200 hover:scale-110 active:scale-95 cursor-pointer <%= isFav ? 'bg-white/90 text-rose-500' : 'bg-white/80 text-gray-400 hover:bg-white hover:text-rose-500' %>"
    aria-label="<%= isFav ? 'Remove from favorites' : 'Add to favorites' %>"
    title="<%= isFav ? 'Remove from favorites' : 'Add to favorites' %>"
  >
    <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
      <path
        d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
      />
    </svg>
  </button>
</form>
<% } %>
